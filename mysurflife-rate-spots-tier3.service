# Systemd Service — rate_spots tier 3 (global, Open-Meteo)
# File location: /etc/systemd/system/mysurflife-rate-spots-tier3.service

[Unit]
Description=MySurfLife rate_spots tier 3 (global Open-Meteo ratings)
After=network.target mysurflife-backend.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/mysurflife/backend
Environment="PATH=/var/www/mysurflife/backend/venv/bin"
ExecStart=/var/www/mysurflife/backend/venv/bin/python -m jobs.rate_spots --tier 3
StandardOutput=journal
StandardError=journal
