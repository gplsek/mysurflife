  "source": "NOAA NOMADS GFSWave GRIB filter (OPeNDAP retired per SCN25-81)",
  "notes": "NOMADS retired OPeNDAP/DODS service (SCN25-81). All wave data now via GRIB filter only. URL structure changed: script=filter_gfswave.pl, dir=%2Fgfs.DATE%2FHH%2Fwave%2Fgridded, file=gfswave.tHHz.DOMAIN.0p16.fFFF.grib2",
  "domains": [
    {
      "id": "global_0p16",
      "name": "Global 0.16°",
      "domain": "global",
      "resolution": {
        "lat_step": 0.16,
        "lon_step": 0.16,
        "lat_step_km": 17.8,
        "lon_step_km": 17.8
      },
      "bounds": {
        "min_lat": -90.0,
        "max_lat": 90.0,
        "min_lon": -180.0,
        "max_lon": 180.0
      },
      "source": "NOAA GFSWave Global",
      "grib_filter_script": "filter_gfswave.pl",
      "grib_file_prefix": "gfswave",
      "grib_file_pattern": "gfswave.t{HH}z.global.0p16.f{FFF}.grib2",
      "grib_dir_pattern": "%2Fgfs.{DATE}%2F{HH}%2Fwave%2Fgridded",
      "variables": {
        "wave_height": {
          "name": "swh",
          "grib_var": "HTSGW",
          "description": "Significant wave height",
          "units": "meters"
        },
        "wave_direction": {
          "name": "dirpw",
          "grib_var": "DIRPW",
          "description": "Primary wave direction",
          "units": "degrees"
        },
        "wave_period": {
          "name": "perpw",
          "grib_var": "PERPW",
          "description": "Primary wave mean period",
          "units": "seconds"
        }
      },
      "use_cases": ["global_overview", "zoom_0_6"],
      "update_frequency": "6 hours",
      "forecast_range": "180 hours"
    },
